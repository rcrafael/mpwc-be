# ============================
# Stage 1: Build the JAR file
# ============================
FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /build

# Copy the entire repository to build context
COPY . .

# Build only the api-user module and its dependencies
RUN mvn -pl api-user -am clean package -DskipTests

# ============================
# Stage 2: Run the JAR
# ============================
FROM eclipse-temurin:17-jdk
WORKDIR /app

# Copy only the built JAR from the previous stage
# Explicit filename to avoid wildcard issue
COPY --from=build /build/api-user/target/api-user-*.jar app.jar

# Expose the port your Spring Boot app runs on
EXPOSE 8080

# Start the application
ENTRYPOINT ["java", "-jar", "app.jar"]
