# ============================
# Stage 1: Build the JAR file
# ============================
FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /build

# Copy the entire repository (so Maven can see parent POM + modules)
COPY . .

# Build only this module and its dependencies
RUN mvn -pl api-user -am clean package -DskipTests

# ============================
# Stage 2: Run the JAR
# ============================
FROM eclipse-temurin:17-jdk
WORKDIR /app

# Copy the JAR file from the correct path in the build stage
# (this is the right path for multi-module)
COPY --from=build /build/api-user/target/api-user-*.jar app.jar

# Expose app port
EXPOSE 8080

# Run the app
ENTRYPOINT ["java", "-jar", "app.jar"]