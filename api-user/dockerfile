# Stage 1: Build the specific module
FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /app

# Copy the entire repo so Maven can resolve parent + shared modules
COPY . .

# Build only this module and its dependencies
RUN mvn -pl api-user -am clean package -DskipTests

# Stage 2: Run the jar
FROM eclipse-temurin:17-jdk
WORKDIR /app

# Copy the built JAR from the previous stage
COPY --from=build /app/api-user/target/api-user-0.0.1-SNAPSHOT.jar app.jar

# Start the app
ENTRYPOINT ["java", "-jar", "app.jar"]